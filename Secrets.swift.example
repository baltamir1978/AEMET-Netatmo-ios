// Copia este archivo a AppPersonal/AppPersonal/Secrets.swift y rellena tus valores.
// Secrets.swift está en .gitignore y nunca se sube al repositorio.
enum Secrets {
    static let netatmoClientId      = ""   // Client ID de la app Netatmo
    static let netatmoClientSecret  = ""   // Client Secret de la app Netatmo
    static let netatmoRefreshToken  = ""   // Refresh token OAuth2 de tu cuenta Netatmo
    static let netatmoDeviceId      = ""   // MAC address de la estación base (70:ee:50:...)
    static let netatmoModuleExt     = ""   // MAC address del módulo exterior (02:00:00:...)
    static let netatmoModuleRain    = ""   // MAC address del módulo de lluvia (05:00:00:...)
    static let netatmoWindId        = ""   // ID de la estación pública de viento (opcional)
    static let aemetApiKey          = ""   // API key de AEMET OpenData
}
