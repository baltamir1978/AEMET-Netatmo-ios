    "Curva de marea del día con tu posición actual. Elige el puerto en «Editar widget»." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corba de marea del dia amb la teva posició actual. Tria el port a «Edita el widget»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today's tide curve with your current position. Pick the port in «Edit widget»."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eguneko marea-kurba zure uneko kokapenarekin. Aukeratu portua «Editatu widgeta» atalean."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curva de marea do día coa túa posición actual. Escolle o porto en «Editar widget»."
          }
        }
      }
    },
