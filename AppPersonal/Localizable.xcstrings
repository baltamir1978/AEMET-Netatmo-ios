    "Automática usa la estación más cercana. Si está al otro lado de la montaña, elige a mano la que comparta tu valle o tu altitud.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Automàtica fa servir l'estació més propera. Si és a l'altra banda de la muntanya, tria a mà la que comparteixi la teva vall o la teva altitud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic uses the nearest station. If it sits on the other side of the mountain, pick the one that shares your valley or your altitude."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikoak estazio hurbilena erabiltzen du. Mendiaren beste aldean badago, aukeratu eskuz zure harana edo altuera partekatzen duena."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automática usa a estación máis próxima. Se está ao outro lado da montaña, escolle a man a que comparta o teu val ou a túa altitude."
          }
        }
      }
    },
